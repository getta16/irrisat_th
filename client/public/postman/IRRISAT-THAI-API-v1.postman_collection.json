              ],
              "query": [
                {
                  "key": "start",
                  "value": "2026-08-01",
                  "description": ""
                },
                {
                  "key": "end",
                  "value": "2026-09-15",
                  "description": ""
                },
                {
                  "key": "weather",
                  "value": "1",
