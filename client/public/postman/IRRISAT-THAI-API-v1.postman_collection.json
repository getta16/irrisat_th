                  "description": ""
                }
              ]
            },
            "description": "กดลูกศรข้างปุ่ม Send → **Send and Download**"
          },
          "response": []
        },
        {
          "name": "09 CSV — ค่าล่าสุดทุกแปลง",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/ndvi/latest?days=60&format=csv",
              "host": [
                "{{base}}"
              ],
              "path": [
                "ndvi",
                "latest"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "60",
                  "description": ""
                },
                {
                  "key": "format",
                  "value": "csv",
                  "description": ""
                }
              ]
            },
            "description": "กดลูกศรข้างปุ่ม Send → **Send and Download** (รอราว 75 วินาทีตอนแคชว่าง)"
          },
          "response": []
        }
      ]
    }
  ]
}
