# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของคุณ

# พอร์ตของ API (ค่าเริ่มต้น 5174 — ต้องตรงกับ proxy ใน client/vite.config.js)
PORT=5174

# ── Google Earth Engine ────────────────────────────────────────────────
# path ไปยังไฟล์ service account key (.json) ที่ดาวน์โหลดจาก Google Cloud
# ใช้ / หรือ \\ คั่นโฟลเดอร์ก็ได้ เช่น D:/GIS_GET/keys/gee-key.json
GEE_SERVICE_ACCOUNT_KEY=

# ชื่อ Google Cloud project ที่เปิดใช้ Earth Engine API
# ถ้าเว้นว่าง ระบบจะอ่าน project_id จากในไฟล์ key ให้เอง
GEE_PROJECT=

# ให้ใช้ข้อมูล NDVI จำลองเมื่อเชื่อมต่อ Earth Engine ไม่ได้ (true/false)
ALLOW_DEMO=true

# ขนาดไฟล์สูงสุดที่อัปโหลดได้ (MB)
MAX_UPLOAD_MB=60

# ── ที่เก็บข้อมูลแปลง ──────────────────────────────────────────────────
# เว้นว่าง = เก็บเป็นไฟล์ server/data/fields.json (พอสำหรับรันในเครื่อง)
#
# ตอน deploy ขึ้น Cloud Run ต้องตั้งเป็นชื่อ bucket บน Google Cloud Storage
# เพราะดิสก์ของคอนเทนเนอร์หายทุกครั้งที่รีสตาร์ต ข้อมูลแปลงจะสูญถ้าไม่ตั้ง
GCS_BUCKET=
GCS_FIELDS_OBJECT=fields.json

# ── เฉพาะตอน deploy ───────────────────────────────────────────────────
# แทนที่จะชี้ไปยังไฟล์คีย์ ให้วางเนื้อ JSON ทั้งก้อนแทนได้ (สะดวกกับ Secret Manager)
# ถ้าตั้งตัวนี้ ระบบจะใช้ตัวนี้ก่อน GEE_SERVICE_ACCOUNT_KEY
# GEE_SERVICE_ACCOUNT_JSON=

# ── ล็อกอินด้วยบัญชี Google (Gmail) ────────────────────────────────────
# OAuth 2.0 Client ID ชนิด "Web application" จาก Google Cloud Console
#   APIs & Services → Credentials → Create credentials → OAuth client ID
# ต้องใส่ Authorized JavaScript origins ให้ตรงกับที่อยู่ของหน้าเว็บ เช่น
#   http://localhost:5173  (ตอนพัฒนา)
#   https://<user>.github.io  หรือ  https://<ชื่อบริการ>.run.app  (ตอนใช้จริง)
#
# เว้นว่าง = ปิดระบบล็อกอิน ใครเปิดหน้าเว็บก็ใช้ได้ (สะดวกตอนพัฒนาในเครื่อง)
GOOGLE_CLIENT_ID=

# จำกัดว่าอีเมลไหนเข้าได้บ้าง คั่นด้วยจุลภาค — เว้นว่างทั้งคู่ = ทุกบัญชี Google เข้าได้
# ALLOWED_EMAILS=somchai@gmail.com,malee@gmail.com
ALLOWED_EMAILS=

# หรือจำกัดเป็นทั้งโดเมน
# ALLOWED_DOMAINS=rid.go.th,ku.ac.th
ALLOWED_DOMAINS=

# แต่ละบัญชีเห็นเฉพาะแปลงของตัวเอง แต่แปลงที่บันทึกไว้ "ก่อน" เปิดใช้การล็อกอิน
# ยังไม่มีเจ้าของ จึงจะไม่มีใครเห็น (ข้อมูลไม่ได้หาย) — ใส่อีเมลตรงนี้เพื่อโอนให้บัญชีนั้น
# ครั้งเดียวตอนเริ่มระบบ แล้วลบบรรทัดนี้ทิ้งได้เลย
LEGACY_OWNER_EMAIL=
